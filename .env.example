# Suno API Configuration
SUNO_API_KEY=your_api_key_here
SUNO_API_BASE_URL=https://api.sunoapi.org

# Built-in webhook receiver (started automatically with the MCP server)
SUNO_CALLBACK_PORT=8090
# Public URL Suno can reach (required for live webhook delivery).
# Leave empty when using NGROK_AUTHTOKEN; Docker will start ngrok automatically.
# Or set manually, e.g. https://abc123.ngrok-free.app
SUNO_CALLBACK_PUBLIC_URL=

# Optional: auto-start ngrok inside Docker and set SUNO_CALLBACK_PUBLIC_URL
# Get your token from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
